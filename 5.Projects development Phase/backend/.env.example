# FoodVerse-AI Backend Configuration
# Copy this file to .env and customize values for your local environment

# Database Settings (MySQL primary)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foodverse
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# Safe local fallback: Set to true to automatically use local SQLite if MySQL is unreachable
DB_FALLBACK_SQLITE=true

# Groq Vision API Key (Optional: for live visual AI food recognition & recipe generation)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Application Configuration
APP_ENV=development
API_PORT=8000

